# Local demo only: bind both servers to loopback. Do not use this shared key publicly.
# The matching browser key below is visible to every user of the frontend.
API_KEY=local-demo-key
VITE_API_KEY=local-demo-key
BACKEND_PORT=8001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defaults persist under .data/ at the repository root (ignored by Git).
# DATABASE_URL=sqlite:///./.data/fdr.db
# STORAGE_DIR=./.data/documents
MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=30

# Deterministic review rules. Amounts are decimal strings; no currency conversion.
MINIMUM_AMOUNT=10000
DEFAULT_CURRENCY=INR
REMINDER_DAYS=30
REQUIRED_FIELDS=instrument_number,bank_name,amount,currency,issue_date,maturity_date,holder_name
# Comma-separated rule IDs, for example MINIMUM_AMOUNT. Use carefully.
DISABLED_RULES=

# demo = labelled text parser; never claims live AI ran.
# gemma = explicit OpenAI-compatible inference adapter, with no silent fallback.
EXTRACTION_MODE=demo
GEMMA_BASE_URL=
GEMMA_MODEL=
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=45
# Example for a separately installed Ollama runtime (verify with ollama list):
# GEMMA_BASE_URL=http://127.0.0.1:11434/v1
# GEMMA_MODEL=gemma4:e2b
# GEMMA_API_KEY=ollama

# Optional, install a compatible PaddleOCR/PaddlePaddle runtime separately.
OCR_ENABLED=false
